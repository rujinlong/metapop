// =============================================================================
// Metapop Nextflow Configuration
// =============================================================================

params {
    // -------------------------------------------------------------------------
    // Input/Output
    // -------------------------------------------------------------------------
    input_dir   = null           // Required: Directory containing BAM files
    output_dir  = "results"      // Output directory
    reference   = null           // Required: Path to reference FASTA
    genes       = null           // Optional: Prodigal gene calls (FASTA format)
    norm_file   = null           // Optional: Normalization file for macrodiversity

    // -------------------------------------------------------------------------
    // Preprocessing Parameters
    // -------------------------------------------------------------------------
    min_len     = 50             // Minimum read alignment length
    min_pct_id  = 95             // Minimum percent identity
    is_global   = false          // true = matches/read_len, false = matches/aln_len
    min_cov     = 20             // Min % breadth of coverage
    min_dep     = 10             // Min truncated average depth
    truncation  = 10             // % to truncate for TAD calculation

    // -------------------------------------------------------------------------
    // SNP Calling Parameters
    // -------------------------------------------------------------------------
    min_qual    = 20             // Minimum PHRED quality for variant calling
    min_obs     = 2              // Min observations of minor allele
    min_pct     = 1              // Min percent of population for minor allele

    // -------------------------------------------------------------------------
    // Gene Prediction Parameters
    // -------------------------------------------------------------------------
    pyrodigal_mode = 'single'    // 'single' or 'meta' mode for pyrodigal

    // -------------------------------------------------------------------------
    // Microdiversity Parameters
    // -------------------------------------------------------------------------
    subsample_size = 10          // Subsampling depth for microdiversity

    // -------------------------------------------------------------------------
    // Module Control
    // -------------------------------------------------------------------------
    skip_preprocessing = false
    skip_snp_calling   = false
    skip_microdiversity = false
    skip_macrodiversity = false
    skip_visualization  = false
}

// =============================================================================
// Process Resource Defaults
// =============================================================================

process {
    // Default error handling
    errorStrategy = 'retry'
    maxRetries    = 2

    // Resource labels
    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8.GB'
        time   = '8.h'
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '16.GB'
        time   = '24.h'
    }
    withLabel: 'process_long' {
        cpus   = 4
        memory = '16.GB'
        time   = '72.h'
    }
}

// =============================================================================
// Execution Profiles
// =============================================================================

profiles {
    // Local execution (default)
    standard {
        process.executor = 'local'
    }

    // Slurm HPC cluster
    slurm {
        process.executor = 'slurm'
        process.queue    = 'general'
        singularity.enabled   = true
        singularity.autoMounts = true
    }

    // Docker (for local development with containers)
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Singularity (for HPC without Docker)
    singularity {
        singularity.enabled   = true
        singularity.autoMounts = true
        singularity.runOptions = "--writable-tmpfs -B /ictstr01/project/genomics -B /project/genomics -B ${HOME} -B /localscratch"
    }

    // Test profile with minimal resources
    test {
        params.input_dir = '${projectDir}/test_data'
        params.reference = '${projectDir}/test_data/reference.fasta'
        params.output_dir = '${projectDir}/test_output'
    }
}

// =============================================================================
// Container Configuration
// =============================================================================

// Uncomment when Docker image is built and pushed
process.container = 'jinlongru/metapop-latest'

// =============================================================================
// Manifest
// =============================================================================

manifest {
    name            = 'metapop-nf'
    author          = 'Jinlong Ru'
    description     = 'Nextflow implementation of MetaPop for metagenomic population analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// =============================================================================
// Reports and Tracing
// =============================================================================

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/trace.txt"
}

dag {
    enabled   = false  // Requires Graphviz - enable if installed
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/dag.svg"
}
